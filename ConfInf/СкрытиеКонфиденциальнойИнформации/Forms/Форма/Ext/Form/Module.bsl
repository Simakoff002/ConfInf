&НаСервере
Функция СкрытиеКонфиденциальнойИнформации()
	
	ИнициализироватьЖурналЛогов();
	ПравилаОбработки = Обработки.СкрытиеКонфиденциальнойИнформации.ПравилаОбработкиПоУмолчанию();
	
	Если ПредставлениеПравилаЧисло = "Умножить"
		Или ПредставлениеПравилаЧисло = "Разделить"
		Или ПредставлениеПравилаЧисло = "Прибавить"
		Или ПредставлениеПравилаЧисло = "Вычесть" Тогда
		Объект.ПравилоЧисло = ПредставлениеПравилаЧисло + ";" + ЗначениеЧисло;
	Иначе
		Объект.ПравилоЧисло = ПредставлениеПравилаЧисло;
	КонецЕсли;
	
	Если ПредставлениеПравилаДата = "НеИзменять" Тогда
		Объект.ПравилоДата = ПредставлениеПравилаДата;
	Иначе
		Объект.ПравилоДата = ПредставлениеПравилаДата + ";" + ЗначениеДата;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПравилаОбработки, Объект);
	
	Если Не ДеревоМетаданныхЗаполнено
		И ЗначениеЗаполнено(АдресХранилища) Тогда
		ДеревоОбрабатываемыхОбъектов = ПолучитьИзВременногоХранилища(АдресХранилища);
	Иначе
		ДеревоОбрабатываемыхОбъектов = РеквизитФормыВЗначение("ОбрабатываемыеОбъекты");
	КонецЕсли;
	АдресХранилищаВторой = "";
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ДеревоОбрабатываемыхОбъектов", ДеревоОбрабатываемыхОбъектов);
	ПараметрыПроцедуры.Вставить("ПравилаОбработки", ПравилаОбработки);
	ПараметрыПроцедуры.Вставить("ТестовыйРежим", ТестовыйРежим);
	
	МодульДлительныеОперации = ОбщийМодуль("ДлительныеОперации");
	Если МодульДлительныеОперации = Неопределено Тогда
		АдресХранилищаВторой = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		РезультатОбработки = ОбработкаОбъект.УничтожитьПерсональныеДанные(ПараметрыПроцедуры, АдресХранилищаВторой);
		Если ТипЗнч(РезультатОбработки) = Тип("Структура") Тогда
			ОтразитьЖурналИзменений(РезультатОбработки.ЖурналИзменений);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	МодульДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗаданияВторой);
	
	ПараметрыВыполненияВФоне = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполненияВФоне.НаименованиеФоновогоЗадания = НСтр("ru = 'Скрытие конфиденциальной информации'");
	ПараметрыВыполненияВФоне.ОжидатьЗавершение = Ложь;
	
	Если ТипЗнч(ОбработкаОбъект) = Тип("ОбработкаОбъект.СкрытиеКонфиденциальнойИнформации") Тогда
		РезультатДлительнойОперации = МодульДлительныеОперации.ВыполнитьВФоне(
			"Обработка.СкрытиеКонфиденциальнойИнформации.МодульОбъекта.УничтожитьПерсональныеДанные",
			ПараметрыПроцедуры,
			ПараметрыВыполненияВФоне);
	Иначе
		РезультатДлительнойОперации = МодульДлительныеОперации.ВыполнитьВФоне(
			"ВнешняяОбработка.СкрытиеКонфиденциальнойИнформации.МодульОбъекта.УничтожитьПерсональныеДанные",
			ПараметрыПроцедуры,
			ПараметрыВыполненияВФоне);
	КонецЕсли;
	
	АдресХранилищаВторой = РезультатДлительнойОперации.АдресРезультата;
	ИдентификаторЗаданияВторой = РезультатДлительнойОперации.ИдентификаторЗадания;
	
	Возврат РезультатДлительнойОперации;
	
КонецФункции

&НаСервере
Функция СохраненныеНастройки(ОбработкаОбъект)
	
	Макеты = ОбработкаОбъект.Метаданные().Макеты;
	
	КоличествоНастроек   = 0;
	СохраненныеНастройки = Новый Массив;
	Для Каждого Макет Из Макеты Цикл
		МакетОбъект = ОбработкаОбъект.ПолучитьМакет(Макет.Имя);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("XML");
		МакетОбъект.Записать(ИмяВременногоФайла);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяВременногоФайла, КодировкаТекста.UTF8);
		СтрокаНастроек = ТекстовыйДокумент.ПолучитьТекст();
		
		СохраненныеНастройки.Добавить(СтрокаНастроек);
		КоличествоНастроек = КоличествоНастроек + 1;
		
		УдалитьФайлы(ИмяВременногоФайла);
	КонецЦикла;
	МакетОпределен = (КоличествоНастроек > 1);
	
	Возврат СохраненныеНастройки;
КонецФункции

&НаСервере
Функция ЗначениеВСтрокуXML(Значение)
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Значение, НазначениеТипаXML.Явное);
	
	Возврат ЗаписьXML.Закрыть();
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбщийМодуль(Имя)
	
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	Если Метаданные.ОбщиеМодули.Найти(Имя) <> Неопределено Тогда
		УстановитьБезопасныйРежим(Истина);
		Модуль = Вычислить(Имя);
	Иначе
		Модуль = Неопределено;
	КонецЕсли;
	
#Иначе
	Модуль = Вычислить(Имя);
#КонецЕсли
	
	Возврат Модуль;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(Знач ТекстСообщенияПользователю)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	
	Сообщение.Сообщить();

	
КонецПроцедуры

#КонецОбласти    

#Область Журнал_логов

// Создает шапку и настраивает ширину колонок в табличном документе журнала логов (включая ГУИД).
//
&НаСервере
Процедура ИнициализироватьЖурналЛогов()
	
	ЖурналЛогов.Очистить();
	ЖурналЛогов.ТолькоПросмотр = Истина; // Включает режим расшифровки (переход по двойному клику)
	
	ЖурналЛогов.Область("R1C1").Текст = НСтр("ru = 'Время'");
	ЖурналЛогов.Область("R1C2").Текст = НСтр("ru = 'Режим'");
	ЖурналЛогов.Область("R1C3").Текст = НСтр("ru = 'ГУИД (UUID)'");
	ЖурналЛогов.Область("R1C4").Текст = НСтр("ru = 'Объект'");
	ЖурналЛогов.Область("R1C5").Текст = НСтр("ru = 'Действие / Реквизит'");
	ЖурналЛогов.Область("R1C6").Текст = НСтр("ru = 'Было'");
	ЖурналЛогов.Область("R1C7").Текст = НСтр("ru = 'Стало'");
	
	Шапка = ЖурналЛогов.Область("R1C1:R1C7");
	Шапка.Шрифт = Новый Шрифт(Шапка.Шрифт,,, Истина);
	
	ЖурналЛогов.Область("C1").ШиринаКолонки = 10;
	ЖурналЛогов.Область("C2").ШиринаКолонки = 10;
	ЖурналЛогов.Область("C3").ШиринаКолонки = 38; // Ширина под стандартный UUID (36 символов)
	ЖурналЛогов.Область("C4").ШиринаКолонки = 30;
	ЖурналЛогов.Область("C5").ШиринаКолонки = 25;
	ЖурналЛогов.Область("C6").ШиринаКолонки = 30;
	ЖурналЛогов.Область("C7").ШиринаКолонки = 30;
	
КонецПроцедуры

// Добавляет одну строку операции в табличный документ логов с автоматическим извлечением GUID ссылки
// и заполнением расшифровки для интерактивного открытия объекта.
//
&НаСервере
Процедура ДобавитьЗаписьВЛог(ОбъектИлиПредставление, Действие, ЗначениеДо, ЗначениеПосле)
	
	СтрокаГУИД           = "";
	СсылкаДляРасшифровки = Неопределено;
	
	Попытка
		СтрокаГУИД           = Строка(ОбъектИлиПредставление.УникальныйИдентификатор());
		СсылкаДляРасшифровки = ОбъектИлиПредставление;
	Исключение
		СтрокаГУИД           = "";
		СсылкаДляРасшифровки = Неопределено;
	КонецПопытки;
	
	НомерСтроки = ЖурналЛогов.ВысотаТаблицы + 1;
	
	ЖурналЛогов.Область(НомерСтроки, 1).Текст = Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss");
	ЖурналЛогов.Область(НомерСтроки, 2).Текст = ?(ТестовыйРежим, "[ТЕСТ]", "[БОЕВОЙ]");
	ЖурналЛогов.Область(НомерСтроки, 3).Текст = СтрокаГУИД;
	ЖурналЛогов.Область(НомерСтроки, 4).Текст = Строка(ОбъектИлиПредставление);
	ЖурналЛогов.Область(НомерСтроки, 5).Текст = Действие;
	ЖурналЛогов.Область(НомерСтроки, 6).Текст = Строка(ЗначениеДо);
	ЖурналЛогов.Область(НомерСтроки, 7).Текст = Строка(ЗначениеПосле);
	
	// Заполнение расшифровки для перехода к объекту
	Если ЗначениеЗаполнено(СсылкаДляРасшифровки) Тогда
		ЖурналЛогов.Область(НомерСтроки, 3).Расшифровка = СсылкаДляРасшифровки;
		ЖурналЛогов.Область(НомерСтроки, 4).Расшифровка = СсылкаДляРасшифровки;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик команды интерактивной очистки журнала логов.
//
&НаКлиенте
Процедура КомандаОчиститьЖурналЛогов(Команда)
	
	Если ЖурналЛогов.ВысотаТаблицы <= 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Журнал логов уже пуст.'"));
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("КомандаОчиститьЖурналЛоговПослеВопроса", ЭтотОбъект);
	
	ПоказатьВопрос(
		Оповещение,
		НСтр("ru = 'Журнал логов содержит данные. Сохранить лог в файл Excel перед очисткой?'"),
		РежимДиалогаВопрос.ДаНетОтмена,
		,
		КодВозвратаДиалога.Да,
		НСтр("ru = 'Очистка журнала логов'")
	);
	
КонецПроцедуры

// Обработчик ответа на вопрос об очистке журнала логов.
//
&НаКлиенте
Процедура КомандаОчиститьЖурналЛоговПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьЖурналВExcel(Новый ОписаниеОповещения("ВыполнитьОчисткуЖурналаЛогов", ЭтотОбъект));
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ВыполнитьОчисткуЖурналаЛогов();
	КонецЕсли;
	// При выборе Отмена очистка не выполняется
	
КонецПроцедуры

// Завершение очистки журнала логов.
//
&НаКлиенте
Процедура ВыполнитьОчисткуЖурналаЛогов(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОчиститьЖурналЛоговНаСервере();
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Журнал логов'"),
		,
		НСтр("ru = 'Журнал логов успешно очищен.'")
	);
	
КонецПроцедуры

// Сбрасывает табличный документ логов и заново формирует шапку таблицы.
//
&НаСервере
Процедура ОчиститьЖурналЛоговНаСервере()
	ИнициализироватьЖурналЛогов();
КонецПроцедуры

&НаСервере
Процедура ОтразитьЖурналИзменений(ТаблицаИзменений)

	Если ТаблицаИзменений = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаИзменения Из ТаблицаИзменений Цикл
		ОбъектДляЛога = ?(ЗначениеЗаполнено(СтрокаИзменения.Ссылка),
			СтрокаИзменения.Ссылка, СтрокаИзменения.ПредставлениеОбъекта);
		ДобавитьЗаписьВЛог(ОбъектДляЛога, СтрокаИзменения.ИмяРеквизита,
			СтрокаИзменения.Было, СтрокаИзменения.Стало);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьЖурналИзРезультата(Результат)

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	АдресРезультата = Неопределено;
	Попытка
		АдресРезультата = Результат.АдресРезультата;
	Исключение
		Возврат;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
		Возврат;
	КонецЕсли;

	ДанныеРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(ДанныеРезультата) = Тип("Структура") Тогда
		ОтразитьЖурналИзменений(ДанныеРезультата.ЖурналИзменений);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СохранитьВExcel

&НаКлиенте
Процедура КомандаСохранитьЖурналВExcel(Команда)
	ОповещениеПослеСохранения = Неопределено;
	СохранитьЖурналВExcel();
КонецПроцедуры


// Инициирует диалог сохранения журнала логов в файл XLSX.
//
&НаКлиенте
Процедура СохранитьЖурналВExcel(ОповещениеПослеСохранения = Неопределено)
	
	Если ЖурналЛогов.ВысотаТаблицы <= 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Журнал логов пуст. Нет данных для сохранения.'"));
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения лога обезличивания'");
	Диалог.Фильтр    = НСтр("ru = 'Книга Excel (*.xlsx)|*.xlsx'");
	Диалог.ПолноеИмяФайла = СтрШаблон("Лог_Обезличивания_%1.xlsx", Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss"));
	
	Оповещение = Новый ОписаниеОповещения("КомандаСохранитьЖурналВExcelЗавершение", ЭтотОбъект, ОповещениеПослеСохранения);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

// Завершение выбора файла: сохранение и передача управления дальше при наличии очереди.
//
&НаКлиенте
Процедура КомандаСохранитьЖурналВExcelЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Если ДополнительныеПараметры <> Неопределено Тогда
			ПоказатьОповещениеПользователя(
				НСтр("ru = 'Выполнение отменено'"),
				,
				НСтр("ru = 'Сохранение файла отменено. Операция не была начата.'")
			);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	
	Попытка
		ЖурналЛогов.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Сохранение завершено'"),
			,
			СтрШаблон(НСтр("ru = 'Файл сохранен: %1'"), ПутьКФайлу)
		);
		
		// Если сохранение инициировано перед запуском шага — запускаем его
		Если ДополнительныеПараметры <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры);
		КонецЕсли;
		
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка при сохранении файла: %1'"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

